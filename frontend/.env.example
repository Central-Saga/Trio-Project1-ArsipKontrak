# Copy to .env.local for local frontend development.

# Server-only API URL used by the Next.js BFF.
API_BASE_URL=http://127.0.0.1:8000/api/v1

# Legacy fallback only. NEXT_PUBLIC_ values are exposed to browser code;
# prefer API_BASE_URL and do not put credentials here.
NEXT_PUBLIC_API_BASE_URL=

# Public origin used to build page metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node environment (development, production, test)
NODE_ENV=development

